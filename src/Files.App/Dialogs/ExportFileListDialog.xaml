<ContentDialog
	x:Class="Files.App.Dialogs.ExportFileListDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{helpers:ResourceString Name=ExportFileListDialog_Header}"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
	PrimaryButtonText="{helpers:ResourceString Name=ExportFileListDialog_ExportButton}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonText="{helpers:ResourceString Name=Cancel}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<Border MinWidth="380" Margin="0,16,0,0">
		<StackPanel Orientation="Vertical" Spacing="12">

			<!--  Scope  -->
			<CheckBox
				Content="{helpers:ResourceString Name=ExportFileListDialog_FilterOption}"
				IsChecked="{x:Bind ViewModel.ApplyCurrentFilter, Mode=TwoWay}"
				IsEnabled="{x:Bind ViewModel.IsFilterOptionEnabled, Mode=OneWay}" />
			<TextBlock
				FontWeight="Normal"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=ExportFileListDialog_FilterLockedHint}"
				Visibility="{x:Bind ViewModel.FilterHintVisibility, Mode=OneWay}" />
			<CheckBox
				Content="{helpers:ResourceString Name=ExportFileListDialog_RecursiveOption}"
				IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}"
				IsEnabled="{x:Bind ViewModel.IsRecursionEnabled, Mode=OneWay}" />

			<!--  Columns  -->
			<TextBlock FontWeight="SemiBold" Text="{helpers:ResourceString Name=ExportFileListDialog_ColumnsHeader}" />
			<ScrollViewer MaxHeight="220">
				<ItemsControl ItemsSource="{x:Bind ViewModel.Columns, Mode=OneWay}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:ExportFileListColumnViewModel" xmlns:local="using:Files.App.ViewModels.Dialogs">
							<CheckBox
								Content="{x:Bind Label}"
								IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!--  Format  -->
			<TextBlock FontWeight="SemiBold" Text="{helpers:ResourceString Name=ExportFileListDialog_FormatHeader}" />
			<StackPanel Orientation="Horizontal" Spacing="16">
				<RadioButton
					x:Name="CsvFormatRadioButton"
					Checked="CsvFormatRadioButton_Checked"
					Content="{helpers:ResourceString Name=ExportFileListDialog_FormatCsv}" />
				<RadioButton
					x:Name="ExcelFormatRadioButton"
					Checked="ExcelFormatRadioButton_Checked"
					Content="{helpers:ResourceString Name=ExportFileListDialog_FormatExcel}" />
			</StackPanel>

		</StackPanel>
	</Border>
</ContentDialog>

<Window
	x:Class="Files.App.Views.SqlQueryWorkbenchWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.UserControls"
	mc:Ignorable="d">

	<Grid
		Padding="12"
		RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Spacing="8">
			<Button
				x:Name="ExecuteButton"
				Click="Execute_Click"
				Content="{helpers:ResourceString Name=SqlExecute}"
				Style="{StaticResource AccentButtonStyle}" />
			<Button
				x:Name="CancelButton"
				Click="Cancel_Click"
				Content="{helpers:ResourceString Name=SqlCancel}"
				IsEnabled="False" />
			<Button Click="Clear_Click" Content="{helpers:ResourceString Name=SqlClearResult}" />
			<ComboBox
				x:Name="ExampleCombo"
				Width="220"
				Header="{helpers:ResourceString Name=SqlExamples}"
				SelectionChanged="ExampleCombo_SelectionChanged" />
			<ProgressRing
				x:Name="BusyRing"
				Width="20"
				Height="20"
				VerticalAlignment="Bottom"
				IsActive="False" />
			<TextBlock
				x:Name="ElapsedText"
				Margin="8,0,0,0"
				VerticalAlignment="Bottom"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</StackPanel>

		<TextBox
			x:Name="SqlEditor"
			Grid.Row="1"
			Height="170"
			AcceptsReturn="True"
			FontFamily="Consolas"
			FontSize="13"
			PlaceholderText="{helpers:ResourceString Name=SqlEditorHeader}"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			TextWrapping="NoWrap">
			<TextBox.KeyboardAccelerators>
				<KeyboardAccelerator
					Key="Enter"
					Modifiers="Control"
					Invoked="ExecuteAccelerator_Invoked" />
			</TextBox.KeyboardAccelerators>
		</TextBox>

		<StackPanel Grid.Row="2" Spacing="2">
			<TextBlock
				FontSize="12"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=SqlWorkbenchHint}" />
			<TextBlock
				FontSize="12"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=SqlSchemaHelp}"
				TextWrapping="Wrap" />
		</StackPanel>

		<StackPanel Grid.Row="3" Spacing="2">
			<TextBlock
				x:Name="StatusText"
				TextWrapping="Wrap" />
			<TextBlock
				x:Name="ErrorText"
				Foreground="{ThemeResource SystemFillColorCriticalBrush}"
				TextWrapping="Wrap"
				Visibility="Collapsed" />
			<TextBlock
				x:Name="StaleText"
				FontSize="12"
				Foreground="{ThemeResource SystemFillColorCautionBrush}"
				Visibility="Collapsed" />
			<TextBlock
				x:Name="TruncatedText"
				FontSize="12"
				Foreground="{ThemeResource SystemFillColorCautionBrush}"
				Visibility="Collapsed" />
		</StackPanel>

		<Border
			Grid.Row="4"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="4">
			<ScrollViewer
				Padding="4"
				HorizontalScrollBarVisibility="Auto"
				VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<ItemsControl x:Name="TableHeaderItems">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									Width="160"
									Padding="6,4"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}">
									<TextBlock
										FontWeight="SemiBold"
										Text="{Binding}"
										TextTrimming="CharacterEllipsis" />
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<ListView
						x:Name="TableRowsItems"
						Padding="0"
						SelectionMode="None">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="vm:QueryTableRow">
								<ItemsControl ItemsSource="{x:Bind Cells}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border
												Width="160"
												Padding="6,3"
												BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
												BorderThickness="0,0,1,1">
												<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>

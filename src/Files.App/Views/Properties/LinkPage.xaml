<vm:BasePropertiesPage
	x:Class="Files.App.Views.Properties.LinkPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.Properties"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	Loaded="Properties_Loaded"
	Tag="Link"
	mc:Ignorable="d">

	<vm:BasePropertiesPage.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ms-appx:///Styles/PropertiesStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</vm:BasePropertiesPage.Resources>

	<ScrollViewer x:Name="RootScrollViewer">
		<StackPanel Padding="12" Spacing="4">

			<Grid
				Padding="12"
				HorizontalAlignment="Stretch"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				ColumnSpacing="8"
				CornerRadius="4"
				RowSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" MinWidth="140" MaxWidth="240" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					VerticalAlignment="Center"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Name=PropertiesLinkType/Text}" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{x:Bind ViewModel.LinkType, Mode=OneWay}" />

				<TextBlock
					x:Name="LinkTargetLabel"
					Grid.Row="1"
					Grid.Column="0"
					VerticalAlignment="Center"
					x:Load="{x:Bind ViewModel.IsLinkTargetVisible, Mode=OneWay}"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Name=PropertiesLinkTarget/Text}" />

				<TextBox
					x:Name="LinkTargetValue"
					Grid.Row="1"
					Grid.Column="1"
					VerticalAlignment="Center"
					IsReadOnly="True"
					Text="{x:Bind ViewModel.LinkTargetPath, Mode=OneWay}"
					x:Load="{x:Bind ViewModel.IsLinkTargetVisible, Mode=OneWay}" />

				<TextBlock
					x:Name="LinkPathTypeLabel"
					Grid.Row="2"
					Grid.Column="0"
					VerticalAlignment="Center"
					x:Load="{x:Bind ViewModel.IsLinkPathTypeVisible, Mode=OneWay}"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Name=PropertiesLinkPathType/Text}" />

				<TextBlock
					x:Name="LinkPathTypeValue"
					Grid.Row="2"
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{x:Bind ViewModel.LinkPathType, Mode=OneWay}"
					x:Load="{x:Bind ViewModel.IsLinkPathTypeVisible, Mode=OneWay}" />

				<TextBlock
					x:Name="LinkTargetStatusLabel"
					Grid.Row="3"
					Grid.Column="0"
					VerticalAlignment="Center"
					x:Load="{x:Bind ViewModel.IsLinkTargetVisible, Mode=OneWay}"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Name=PropertiesLinkTargetStatus/Text}" />

				<TextBlock
					x:Name="LinkTargetStatusValue"
					Grid.Row="3"
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{x:Bind ViewModel.LinkTargetStatus, Mode=OneWay}"
					x:Load="{x:Bind ViewModel.IsLinkTargetVisible, Mode=OneWay}" />
			</Grid>

			<Grid
				x:Name="HardLinkCard"
				Padding="12"
				HorizontalAlignment="Stretch"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				ColumnSpacing="8"
				CornerRadius="4"
				RowSpacing="8"
				x:Load="{x:Bind ViewModel.IsHardLink, Mode=OneWay}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" MinWidth="140" MaxWidth="240" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Style="{StaticResource PropertyName}"
					Text="{helpers:ResourceString Name=PropertiesLinkHardLinkCount/Text}" />

				<TextBlock
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{x:Bind ViewModel.LinkHardLinkCountText, Mode=OneWay}" />
			</Grid>

			<wctcontrols:SettingsCard
				x:Name="OpenLinkTargetCard"
				x:Load="{x:Bind ViewModel.IsLinkTargetVisible, Mode=OneWay}"
				Command="{x:Bind ViewModel.OpenLinkTargetCommand, Mode=OneWay}"
				Header="{helpers:ResourceString Name=LinkOpenTarget}"
				IsClickEnabled="True">
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE8A7;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

			<wctcontrols:SettingsCard
				x:Name="CopyLinkTargetCard"
				x:Load="{x:Bind ViewModel.IsLinkTargetVisible, Mode=OneWay}"
				Command="{x:Bind ViewModel.CopyLinkTargetCommand, Mode=OneWay}"
				Header="{helpers:ResourceString Name=LinkCopyTarget}"
				IsClickEnabled="True">
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE8C8;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

		</StackPanel>
	</ScrollViewer>
</vm:BasePropertiesPage>

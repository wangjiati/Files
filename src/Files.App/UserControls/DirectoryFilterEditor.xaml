<UserControl
	x:Class="Files.App.UserControls.DirectoryFilterEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.UserControls"
	xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<SolidColorBrush x:Key="TransparentBorderBrush" Color="Transparent" />
			<wctconverters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
			<wctconverters:BoolToVisibilityConverter
				x:Key="NegatedBoolToVisibility"
				FalseValue="Visible"
				TrueValue="Collapsed" />
			<wctconverters:BoolToObjectConverter
				x:Key="DraftBorderBrush"
				FalseValue="{ThemeResource ControlStrokeColorDefaultBrush}"
				TrueValue="{StaticResource TransparentBorderBrush}" />
		</ResourceDictionary>
	</UserControl.Resources>

	<!--  The outline marks a draft condition  -->
	<Border
		x:Name="EditorBorder"
		MinWidth="220"
		Padding="6"
		BorderBrush="{x:Bind ViewModel.IsActive, Mode=OneWay, Converter={StaticResource DraftBorderBrush}}"
		BorderThickness="1"
		CornerRadius="4">
		<StackPanel Spacing="10">
			<TextBlock
				FontWeight="SemiBold"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

			<!--  Name column: text and regex are alternative modes  -->
			<StackPanel
				x:Name="TextPanel"
				Spacing="6"
				Visibility="{x:Bind ViewModel.IsTextColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<SelectorBar x:Name="MatchModeSelector" SelectionChanged="MatchMode_SelectionChanged">
					<SelectorBarItem x:Name="TextModeItem" Text="{helpers:ResourceString Name=FilterModeText}" />
					<SelectorBarItem x:Name="RegexModeItem" Text="{helpers:ResourceString Name=FilterModeRegex}" />
				</SelectorBar>
				<StackPanel
					x:Name="TextMatchPanel"
					Spacing="6"
					Visibility="{x:Bind ViewModel.UseRegex, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}">
					<ComboBox
						x:Name="OperatorCombo"
						HorizontalAlignment="Stretch"
						SelectedIndex="{x:Bind ViewModel.OperatorIndex, Mode=TwoWay}" />
					<ComboBox
						x:Name="ScopeCombo"
						Header="{helpers:ResourceString Name=FilterRegexTarget}"
						HorizontalAlignment="Stretch"
						SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}" />
					<TextBox
						x:Name="FilterTextBox"
						PlaceholderText="{helpers:ResourceString Name=Filter}"
						Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Visibility="{x:Bind ViewModel.IsLengthOperator, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}" />
					<NumberBox
						x:Name="LengthBox"
						Header="{helpers:ResourceString Name=FilterNameLength}"
						Minimum="0"
						SmallChange="1"
						SpinButtonPlacementMode="Compact"
						Value="{x:Bind LengthValue, Mode=TwoWay}"
						Visibility="{x:Bind ViewModel.IsLengthOperator, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
				</StackPanel>
				<StackPanel
					x:Name="RegexOptionsPanel"
					Spacing="6"
					Visibility="{x:Bind ViewModel.UseRegex, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
					<ComboBox
						x:Name="RegexTargetCombo"
						Header="{helpers:ResourceString Name=FilterRegexTarget}"
						HorizontalAlignment="Stretch"
						SelectedIndex="{x:Bind ViewModel.RegexTargetIndex, Mode=TwoWay}" />
					<CheckBox
						x:Name="RegexIgnoreCaseCheck"
						Checked="RegexIgnoreCase_Changed"
						Content="{helpers:ResourceString Name=FilterRegexIgnoreCase}"
						Unchecked="RegexIgnoreCase_Changed" />
					<TextBox
						x:Name="RegexPatternBox"
						PlaceholderText="{helpers:ResourceString Name=FilterRegexPattern}"
						Text="{x:Bind ViewModel.RegexPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock
						x:Name="RegexErrorText"
						Foreground="{ThemeResource SystemFillColorCriticalBrush}"
						TextWrapping="Wrap"
						Visibility="Collapsed" />
				</StackPanel>
			</StackPanel>

			<!--  Type and tag columns  -->
			<StackPanel
				x:Name="ChoicePanel"
				Spacing="6"
				Visibility="{x:Bind ViewModel.IsChoiceColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<ListView
					x:Name="ChoicesList"
					MaxHeight="220"
					SelectionMode="None"
					Visibility="{x:Bind IsChoiceListVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="vm:DirectoryFilterValueOption">
							<CheckBox
								MinWidth="0"
								Content="{x:Bind Label}"
								IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
				<CheckBox
					x:Name="IncludeEmptyCheck"
					Content="{helpers:ResourceString Name=FilterIncludeEmpty}"
					IsChecked="{x:Bind ViewModel.IncludeEmpty, Mode=TwoWay}"
					Visibility="{x:Bind IsIncludeEmptyVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
			</StackPanel>

			<!--  Extensions are a separate dimension in the inline editor  -->
			<StackPanel
				x:Name="ExtensionPanel"
				Spacing="6"
				Visibility="{x:Bind IsExtensionSectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<TextBlock
					FontSize="12"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{helpers:ResourceString Name=FilterExtensionSection}" />
				<ListView
					x:Name="ExtensionList"
					MaxHeight="160"
					SelectionMode="None">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="vm:DirectoryFilterValueOption">
							<CheckBox
								MinWidth="0"
								Content="{x:Bind Label}"
								IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</StackPanel>

			<!--  Size range  -->
			<Grid
				x:Name="SizePanel"
				ColumnSpacing="6"
				Visibility="{x:Bind ViewModel.IsSizeColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Spacing="4">
					<TextBlock FontSize="12" Text="{helpers:ResourceString Name=FilterMinSize}" />
					<TextBox
						x:Name="MinSizeBox"
						Text="{x:Bind ViewModel.MinSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<ComboBox
					x:Name="SizeUnitCombo"
					Grid.Column="1"
					Width="72"
					VerticalAlignment="Bottom"
					SelectedIndex="{x:Bind ViewModel.SizeUnitIndex, Mode=TwoWay}" />

				<StackPanel Grid.Column="2" Spacing="4">
					<TextBlock FontSize="12" Text="{helpers:ResourceString Name=FilterMaxSize}" />
					<TextBox
						x:Name="MaxSizeBox"
						Text="{x:Bind ViewModel.MaxSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>
			</Grid>

			<!--  Date range  -->
			<StackPanel
				x:Name="DatePanel"
				Spacing="6"
				Visibility="{x:Bind ViewModel.IsDateColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<ComboBox
					x:Name="DatePresetCombo"
					HorizontalAlignment="Stretch"
					SelectionChanged="DatePreset_SelectionChanged" />
				<Grid ColumnSpacing="6">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<CalendarDatePicker
						x:Name="MinDatePicker"
						Grid.Column="0"
						Date="{x:Bind ViewModel.MinDate, Mode=TwoWay}"
						PlaceholderText="{helpers:ResourceString Name=FilterFrom}" />
					<CalendarDatePicker
						x:Name="MaxDatePicker"
						Grid.Column="1"
						Date="{x:Bind ViewModel.MaxDate, Mode=TwoWay}"
						PlaceholderText="{helpers:ResourceString Name=FilterTo}" />
				</Grid>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>

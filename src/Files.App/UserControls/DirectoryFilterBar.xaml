<UserControl
	x:Class="Files.App.UserControls.DirectoryFilterBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.UserControls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.UserControls"
	xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
	mc:Ignorable="d">

	<UserControl.KeyboardAccelerators>
		<KeyboardAccelerator
			Key="F"
			Invoked="FocusFilter_Invoked"
			Modifiers="Control,Shift" />
	</UserControl.KeyboardAccelerators>

	<UserControl.Resources>
		<ResourceDictionary>
			<wctconverters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
			<wctconverters:BoolToVisibilityConverter
				x:Key="NegatedBoolToVisibility"
				FalseValue="Visible"
				TrueValue="Collapsed" />
			<DataTemplate x:Key="ConditionTemplate" x:DataType="vm:DirectoryFilterViewModel">
				<StackPanel
					Orientation="Horizontal"
					Spacing="4"
					VerticalAlignment="Top">
					<Button
						x:Name="JoinButton"
						Click="JoinButton_Click"
						Content="{helpers:ResourceString Name=FilterJoinAndContent}"
						Loaded="JoinButton_Loaded"
						VerticalAlignment="Top" />
					<local:DirectoryFilterFlyout
						IsInline="True"
						ShowFooter="False"
						VerticalAlignment="Top"
						ViewModel="{x:Bind}" />
					<Button
						AutomationProperties.Name="{helpers:ResourceString Name=Remove}"
						Click="RemoveCondition_Click"
						ToolTipService.ToolTip="{helpers:ResourceString Name=Remove}"
						VerticalAlignment="Top">
						<FontIcon FontSize="12" Glyph="&#xE74D;" />
					</Button>
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>

	<Border
		Padding="26,8,12,8"
		BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		BorderThickness="0,0,0,1">
		<StackPanel Spacing="8">
			<StackPanel
				Orientation="Horizontal"
				Spacing="8"
				VerticalAlignment="Center">
				<SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged">
					<SelectorBarItem x:Name="BasicModeItem" Text="{helpers:ResourceString Name=FilterModeBasic}" />
					<SelectorBarItem x:Name="AdvancedModeItem" Text="{helpers:ResourceString Name=FilterModeAdvanced}" />
				</SelectorBar>

				<TextBox
					x:Name="KeywordBox"
					Width="220"
					PlaceholderText="{helpers:ResourceString Name=FilterKeywordsPlaceholder}"
					Text="{x:Bind ViewModel.KeywordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					VerticalAlignment="Center"
					Visibility="{x:Bind ViewModel.IsBasicMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

				<local:DirectoryFilterFlyout
					x:Name="NameEditor"
					IsInline="True"
					ShowFooter="False"
					VerticalAlignment="Top"
					ViewModel="{x:Bind ViewModel.NameCondition, Mode=OneWay}"
					Visibility="{x:Bind ViewModel.IsBasicMode, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}"
					Width="260" />

				<Button
					Content="{helpers:ResourceString Name=FilterAddConditionContent}"
					VerticalAlignment="Top"
					Visibility="{x:Bind ViewModel.IsBasicMode, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}">
					<Button.Flyout>
						<MenuFlyout>
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="Name"
								Text="{helpers:ResourceString Name=Name}" />
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="Type"
								Text="{helpers:ResourceString Name=Type}" />
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="Extension"
								Text="{helpers:ResourceString Name=FilterExtensionSection}" />
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="Tags"
								Text="{helpers:ResourceString Name=Tag}" />
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="Size"
								Text="{helpers:ResourceString Name=Size}" />
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="ModifiedDate"
								Text="{helpers:ResourceString Name=DateModifiedLowerCase}" />
							<MenuFlyoutItem
								Click="AddCondition_Click"
								Tag="CreatedDate"
								Text="{helpers:ResourceString Name=DateCreated}" />
						</MenuFlyout>
					</Button.Flyout>
				</Button>

				<CheckBox
					Content="{helpers:ResourceString Name=FilterRecursiveContent}"
					IsChecked="{x:Bind ViewModel.RecursiveEnabled, Mode=TwoWay}"
					VerticalAlignment="Center" />

				<ComboBox
					x:Name="DepthCombo"
					MinWidth="110"
					SelectionChanged="DepthCombo_SelectionChanged"
					VerticalAlignment="Center"
					Visibility="{x:Bind ViewModel.RecursiveEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

				<TextBlock
					x:Name="CountText"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					VerticalAlignment="Center"
					Visibility="Collapsed" />

				<Button
					Click="ClearAll_Click"
					Content="{helpers:ResourceString Name=FilterClearAll}"
					VerticalAlignment="Center" />
			</StackPanel>

			<ItemsControl
				ItemTemplate="{StaticResource ConditionTemplate}"
				ItemsSource="{x:Bind ViewModel.Conditions, Mode=OneWay}"
				Visibility="{x:Bind ViewModel.IsBasicMode, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibility}}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="4" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</StackPanel>
	</Border>
</UserControl>

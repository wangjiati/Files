<UserControl
	x:Class="Files.App.UserControls.DirectoryFilterColumnFlyout"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.UserControls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<StackPanel
		Padding="16"
		PreviewKeyDown="Content_PreviewKeyDown"
		Spacing="12"><!--  Same editor and query language as the top bar  -->
		<local:DirectoryFilterColumnEditor x:Name="ColumnEditor" />

		<StackPanel
			Orientation="Horizontal"
			Spacing="8"
			HorizontalAlignment="Right">
			<Button
				Click="ClearAll_Click"
				Content="{helpers:ResourceString Name=FilterClearAll}" />
			<Button
				Click="Clear_Click"
				Content="{helpers:ResourceString Name=Clear}" />
			<Button
				Click="Apply_Click"
				Content="{helpers:ResourceString Name=FilterApply}"
				Style="{StaticResource AccentButtonStyle}" />
		</StackPanel>
	</StackPanel>
</UserControl>

<UserControl
	x:Class="Files.App.UserControls.DirectoryFilterColumnEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.UserControls"
	mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="FieldLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
		</Style>
	</UserControl.Resources>

	<!--  Vertical form used by the column filter popup; the top bar keeps its compact inline editor.  -->
	<StackPanel
		Width="340"
		Spacing="12">

		<TextBlock
			x:Name="TitleText"
			FontSize="16"
			FontWeight="SemiBold" />

		<!--  Name column: free text or a regular expression  -->
		<StackPanel
			x:Name="TextPanel"
			Spacing="10"
			Visibility="Collapsed">
			<SelectorBar x:Name="MatchModeSelector" SelectionChanged="MatchMode_SelectionChanged">
				<SelectorBarItem x:Name="TextModeItem" />
				<SelectorBarItem x:Name="RegexModeItem" />
			</SelectorBar>

			<!--  Both modes keep one 32px row so switching to regex never resizes the popup.  -->
			<Grid>
				<Grid
					x:Name="TextMatchPanel"
					ColumnSpacing="8"
					Visibility="Collapsed">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<ComboBox
						x:Name="OperatorCombo"
						Width="112"
						Height="32"
						VerticalAlignment="Center" />
					<TextBox
						x:Name="FilterTextBox"
						Grid.Column="1"
						Height="32"
						KeyDown="TextInput_KeyDown"
						PlaceholderText="{helpers:ResourceString Name=Filter}" />
				</Grid>

				<TextBox
					x:Name="RegexPatternBox"
					Height="32"
					KeyDown="TextInput_KeyDown"
					PlaceholderText="{helpers:ResourceString Name=FilterRegexPattern}"
					Visibility="Collapsed" />
			</Grid>

			<TextBlock
				x:Name="RegexErrorText"
				Foreground="{ThemeResource SystemFillColorCriticalBrush}"
				TextWrapping="Wrap"
				Visibility="Collapsed" />

			<!--  Shared by both modes: comparison and scope  -->
			<StackPanel Orientation="Horizontal" Spacing="16">
				<CheckBox x:Name="CaseCheck" Content="{helpers:ResourceString Name=FilterCaseSensitive}" />
				<CheckBox x:Name="ExtensionCheck" Content="{helpers:ResourceString Name=FilterIncludeExtension}" />
			</StackPanel>
		</StackPanel>

		<!--  Type and tag columns: pick values  -->
		<StackPanel
			x:Name="ChoicePanel"
			Spacing="6"
			Visibility="Collapsed">
			<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterValues}" />
			<ListView
				x:Name="ChoicesList"
				MaxHeight="240"
				SelectionMode="None">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="MinHeight" Value="32" />
						<Setter Property="Padding" Value="4,0" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="vm:DirectoryFilterValueOption">
						<CheckBox
							MinWidth="0"
							Content="{x:Bind Label}"
							IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Click="SelectAll_Click" Content="{helpers:ResourceString Name=FilterSelectAll}" />
				<Button Click="ClearSelection_Click" Content="{helpers:ResourceString Name=FilterClearSelection}" />
				<CheckBox
					x:Name="IncludeEmptyCheck"
					Content="{helpers:ResourceString Name=FilterIncludeEmpty}"
					VerticalAlignment="Center" />
			</StackPanel>
		</StackPanel>

		<!--  Extension column  -->
		<StackPanel
			x:Name="ExtensionPanel"
			Spacing="6"
			Visibility="Collapsed">
			<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterExtensionSection}" />
			<ListView
				x:Name="ExtensionList"
				MaxHeight="200"
				SelectionMode="None">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="MinHeight" Value="32" />
						<Setter Property="Padding" Value="4,0" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="vm:DirectoryFilterValueOption">
						<CheckBox
							MinWidth="0"
							Content="{x:Bind Label}"
							IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<CheckBox
				x:Name="IncludeEmptyExtensionCheck"
				Content="{helpers:ResourceString Name=FilterIncludeEmpty}" />
		</StackPanel>

		<!--  Size range  -->
		<Grid
			x:Name="SizePanel"
			ColumnSpacing="8"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Spacing="4">
				<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterMinSize}" />
				<TextBox x:Name="MinSizeBox" KeyDown="TextInput_KeyDown" />
			</StackPanel>

			<ComboBox
				x:Name="SizeUnitCombo"
				Grid.Column="1"
				Width="80"
				VerticalAlignment="Bottom" />

			<StackPanel Grid.Column="2" Spacing="4">
				<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterMaxSize}" />
				<TextBox x:Name="MaxSizeBox" KeyDown="TextInput_KeyDown" />
			</StackPanel>
		</Grid>

		<!--  Date range  -->
		<StackPanel
			x:Name="DatePanel"
			Spacing="8"
			Visibility="Collapsed">
			<StackPanel Spacing="4">
				<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterDatePreset}" />
				<ComboBox
					x:Name="DatePresetCombo"
					HorizontalAlignment="Stretch"
					SelectionChanged="DatePreset_SelectionChanged" />
			</StackPanel>
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Spacing="4">
					<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterFrom}" />
					<CalendarDatePicker
						x:Name="MinDatePicker"
						HorizontalAlignment="Stretch" />
				</StackPanel>
				<StackPanel Grid.Column="1" Spacing="4">
					<TextBlock Style="{StaticResource FieldLabelStyle}" Text="{helpers:ResourceString Name=FilterTo}" />
					<CalendarDatePicker
						x:Name="MaxDatePicker"
						HorizontalAlignment="Stretch" />
				</StackPanel>
			</Grid>
		</StackPanel>
	</StackPanel>
</UserControl>
